  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "API Gateway & Traffic Overview",
      "type": "row"
    },
    {
      "id": 1,
      "title": "HTTP Request Rate (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(snacky_http_requests_total[1m])) by (method, endpoint)",
          "legendFormat": "{{method}} {{endpoint}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP Error Rate (4xx / 5xx)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(snacky_http_requests_total{status_code=~\"4..\"}[1m]))",
          "legendFormat": "Client Errors (4xx)"
        },
        {
          "expr": "sum(rate(snacky_http_requests_total{status_code=~\"5..\"}[1m]))",
          "legendFormat": "Server Errors (5xx)"
        }
      ]
    },
    {
      "id": 3,
      "title": "API Latency (p50, p95, p99)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(snacky_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(snacky_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(snacky_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 101,
      "title": "Distributed Task Queue & Workers",
      "type": "row"
    },
    {
      "id": 4,
      "title": "Queue Depth by Tenant",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 9 },
      "targets": [
        {
          "expr": "sum(snacky_queue_depth) by (tenant_id)",
          "legendFormat": "Tenant: {{tenant_id}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Active Worker Execution Concurrency",
      "type": "gauge",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 9 },
      "targets": [
        {
          "expr": "snacky_worker_active_jobs",
          "legendFormat": "Running Worker Jobs"
        }
      ]
    },
    {
      "id": 6,
      "title": "Job Completion Rate vs Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 9 },
      "targets": [
        {
          "expr": "sum(rate(snacky_jobs_total{status=\"completed\"}[5m]))",
          "legendFormat": "Completed Jobs/sec"
        },
        {
          "expr": "sum(rate(snacky_jobs_total{status=\"error\"}[5m]))",
          "legendFormat": "Failed Jobs/sec"
        },
        {
          "expr": "sum(rate(snacky_jobs_total{status=\"cancelled\"}[5m]))",
          "legendFormat": "Cancelled Jobs/sec"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 102,
      "title": "Realtime SSE, Quotas & Webhooks",
      "type": "row"
    },
    {
      "id": 7,
      "title": "Active SSE Streams by Tenant",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 17 },
      "targets": [
        {
          "expr": "sum(snacky_sse_connections_active) by (tenant_id)",
          "legendFormat": "SSE Streams: {{tenant_id}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Quota Rejections & Rate Limit 429s",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 17 },
      "targets": [
        {
          "expr": "sum(rate(snacky_quota_rejections_total[1m])) by (reason, tenant_id)",
          "legendFormat": "{{tenant_id}} - {{reason}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Outbound Webhook Deliveries",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 17 },
      "targets": [
        {
          "expr": "sum(rate(snacky_webhook_deliveries_total{status=\"delivered\"}[5m]))",
          "legendFormat": "Delivered"
        },
        {
          "expr": "sum(rate(snacky_webhook_deliveries_total{status=\"failed\"}[5m]))",
          "legendFormat": "Failed"
        }
      ]
    }
  ],
