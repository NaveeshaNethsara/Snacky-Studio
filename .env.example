# Snacky Studio - Local Desktop Development Configuration
# Zero-config default: local SQLite database, in-process workers, no cloud auth required.
SNACKY_MODE=local

# Optional: Custom directories
# SNACKY_DOWNLOADS_DIR=downloads
# SNACKY_DATA_DIR=.snacky

# Optional: Custom Netscape cookies file for authenticated social media extraction
# SNACKY_COOKIES_FILE=cookies.txt
